# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Generate fresh burner wallets with:
#   cast wallet new

# ---------------------------------------------------------------- network
# Monad Testnet, chain id 10143. Alternates if the primary RPC gets flaky:
#   https://rpc.ankr.com/monad_testnet
#   https://rpc-testnet.monadinfra.com
RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------- deployer
# Needs testnet MON from https://faucet.monad.xyz or the Blitz event page.
# It deploys the contract and funds the three demo wallets via scripts/fund.sh.
DEPLOYER_ADDRESS=0x
DEPLOYER_PK=0x

# ----------------------------------------------------------------- referee
# Signs pass/fail verdicts offchain. Its address is baked into the contract at
# deploy time. It never needs MON: anyone can relay the signature into attest().
REFEREE_ADDRESS=0x
REFEREE_PK=0x

# ------------------------------------------------------------ demo wallets
# The three friends in the demo circle. Keys stay server side; the browser only
# ever learns the addresses.
ALICE_ADDRESS=0x
ALICE_PK=0x
BOB_ADDRESS=0x
BOB_PK=0x
CARA_ADDRESS=0x
CARA_PK=0x

# ---------------------------------------------------------------- contract
# Fill both in after running script/Deploy.s.sol. The NEXT_PUBLIC_ one is what
# the browser reads; the other is used by scripts/e2e-testnet.sh.
FOCUSBOND_ADDRESS=0x
NEXT_PUBLIC_FOCUSBOND_ADDRESS=0x

# ----------------------------------------------------------- AI referee
# REFEREE_MODE controls how proof screenshots are judged:
#   auto      use the vision model when OPENAI_API_KEY is set, else heuristic (default)
#   ai        require the vision model; on failure fall back to heuristic
#   heuristic skip the model entirely and judge on the filename
#   off       issue no verdicts at all, leaving only the onchain challenge path
#
# The referee can never block a check-in: a missing key, a timeout or an API
# error always degrades to a weaker verdict rather than a failed check-in.
REFEREE_MODE=auto
OPENAI_API_KEY=
